+type Cell = { ch: string; fg?: string; bg?: string }
+
+function cells(px: string[]): Cell[][] {
+  const out: Cell[][] = []
+  for (let y = 0; y < px.length; y += 2) {
+    const a = px[y] ?? ""
+    const b = px[y + 1] ?? ""
+    const row: Cell[] = []
+    for (let x = 0; x < Math.max(a.length, b.length); x++) {
+      const t = a[x] && a[x] !== "." ? a[x] : undefined
+      const u = b[x] && b[x] !== "." ? b[x] : undefined
+      if (!t && !u) row.push({ ch: " " })
+      else if (t && !u) row.push({ ch: "▀", fg: t })
+      else if (!t && u) row.push({ ch: "▄", fg: u })
+      else if (t === u) row.push({ ch: "█", fg: t })
+      else row.push({ ch: "▀", fg: t, bg: u })
+    }
+    out.push(row)
+  }
+  return out
+}
